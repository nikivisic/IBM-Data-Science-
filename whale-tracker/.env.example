# ---------------------------------------------------------------------------
# whale-tracker configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- API keys --------------------------------------------------------------
# https://dashboard.helius.dev  -> create an API key. Required: trade history
# comes from Helius and there is no keyless substitute for it.
HELIUS_API_KEY=
# Optional. Prices come from keyless sources by default; Birdeye is only used
# when ENABLE_BIRDEYE=true below.
# https://bds.birdeye.so  -> create an API key
BIRDEYE_API_KEY=

# --- API endpoints (only change if you use a custom/self-hosted endpoint) ---
HELIUS_BASE_URL=https://api.helius.xyz
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
BIRDEYE_BASE_URL=https://public-api.birdeye.so
JUPITER_BASE_URL=https://api.jup.ag
DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com

# --- Storage ---------------------------------------------------------------
# Path to the SQLite database file (relative paths resolve from the CWD).
WHALE_DB_PATH=data/whale_tracker.db

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# "json" for machine-readable structured logs, "console" for human-readable.
LOG_FORMAT=json
# Optional: also write structured logs to this file (leave empty to disable).
LOG_FILE=

# --- Price sources ---------------------------------------------------------
# Keyless chain, tried in this order. Only GeckoTerminal serves *historical*
# prices; the other two are spot-only and are skipped for old timestamps.
PRICE_SOURCES=jupiter,dexscreener,geckoterminal
# Add Birdeye to the end of the chain (needs BIRDEYE_API_KEY). Off by default.
ENABLE_BIRDEYE=false
# Historical price points are cached this long (they never change).
PRICE_CACHE_TTL_SECONDS=86400
# Spot prices are cached this long.
SPOT_PRICE_TTL_SECONDS=300
# After a 429, a source is skipped for this many seconds and the chain moves on.
PRICE_SOURCE_COOLDOWN_SECONDS=300

# --- HTTP client behaviour -------------------------------------------------
# Requests per second, per provider. Free tiers are strict: GeckoTerminal
# allows ~30/min, DexScreener ~300/min, Jupiter is generous.
HELIUS_RATE_LIMIT_RPS=8
BIRDEYE_RATE_LIMIT_RPS=1
JUPITER_RATE_LIMIT_RPS=2
DEXSCREENER_RATE_LIMIT_RPS=4
GECKOTERMINAL_RATE_LIMIT_RPS=0.5
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
# Cache GET responses in SQLite for this many seconds (0 disables the cache).
HTTP_CACHE_TTL_SECONDS=86400

# --- Ingestion limits (guardrails against runaway API spend) ---------------
# Max parsed transactions to pull per token before stopping.
MAX_TXS_PER_TOKEN=5000
# Ignore trades smaller than this USD value (dust / wash noise).
MIN_TRADE_USD=10

# --- Fan-out caps for `expand` ---------------------------------------------
# At most this many candidate wallets are taken from each seed token, ranked by
# their USD volume in that token. Without it, one busy mint with 40,000 traders
# would consume the entire expansion budget.
MAX_WALLETS_PER_TOKEN=50
# Transactions pulled per wallet. Low on purpose: the first pages carry most of
# the signal, and this multiplies by the wallet count.
MAX_TXS_PER_WALLET=200

# --- API budget caps -------------------------------------------------------
# Hard caps, enforced before each call. Hitting one aborts the run with a
# message naming the provider and the limit — nothing degrades silently.
# Set to 0 for "unlimited". Daily counters are UTC and persist in the database,
# so a restart does not hand out a fresh allowance.
BUDGET_ENFORCE=true

HELIUS_MAX_REQUESTS_PER_RUN=5000
HELIUS_MAX_REQUESTS_PER_DAY=50000
HELIUS_MAX_CREDITS_PER_RUN=100000
HELIUS_MAX_CREDITS_PER_DAY=250000
# Informational: used by `status` and `--dry-run` to show how a run sizes
# against your plan. The Helius free tier is 1,000,000 credits/month.
HELIUS_MONTHLY_CREDIT_BUDGET=1000000

BIRDEYE_MAX_REQUESTS_PER_RUN=2000
BIRDEYE_MAX_REQUESTS_PER_DAY=20000

# Applied to EACH keyless price source separately, not to all of them together.
PRICE_MAX_REQUESTS_PER_RUN=1000
PRICE_MAX_REQUESTS_PER_DAY=10000

# --- Transaction-history endpoint ------------------------------------------
# Which endpoint serves wallet/token history. "auto" tries them cheapest first
# and falls back only when one is missing or not enabled on your plan:
#   parsed_events -> bulk_history -> enhanced_tx
# The Enhanced Transactions API is billed at 100 credits per call and Helius
# now recommends migrating off it, so it is the last resort, not the default.
# auto | parsed_events | bulk_history | enhanced_tx
HELIUS_HISTORY_STRATEGY=auto

# Parsed Events API (open beta). Change if your account exposes another path;
# a 404 here simply moves the chain on to the next endpoint.
HELIUS_PARSED_EVENTS_PATH=/v1/parsed-events

# Bulk address history over RPC. Change if your plan names the method
# differently; an unknown method moves the chain on.
HELIUS_BULK_HISTORY_METHOD=getTransactionsForAddress
# Option key used to filter that method by transaction type (e.g. "type").
# Empty means send no filter — an unknown option is rejected by some RPCs.
HELIUS_BULK_HISTORY_FILTER=
# Transactions requested per page.
HELIUS_HISTORY_PAGE_SIZE=100

# --- Helius credit costs per call ------------------------------------------
# What one call is billed. Ordinary RPC is 1 credit; getProgramAccounts and the
# DAS methods are 10. History endpoints differ by an order of magnitude, which
# is the whole reason for the chain above — confirm these against your plan,
# because the history rate dominates every estimate.
HELIUS_CREDITS_RPC=1
HELIUS_CREDITS_HEAVY_RPC=10
HELIUS_CREDITS_DAS=10
HELIUS_CREDITS_ENHANCED_TX=100
HELIUS_CREDITS_PARSED_EVENTS=10
HELIUS_CREDITS_BULK_HISTORY=10
HELIUS_CREDITS_SIGNATURES=1
HELIUS_CREDITS_TRANSACTION=1
