# ---------------------------------------------------------------------------
# whale-tracker configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- API keys (required for live ingestion) --------------------------------
# https://dashboard.helius.dev  -> create an API key
HELIUS_API_KEY=
# https://bds.birdeye.so  -> create an API key
BIRDEYE_API_KEY=

# --- API endpoints (only change if you use a custom/self-hosted endpoint) ---
HELIUS_BASE_URL=https://api.helius.xyz
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
BIRDEYE_BASE_URL=https://public-api.birdeye.so

# --- Storage ---------------------------------------------------------------
# Path to the SQLite database file (relative paths resolve from the CWD).
WHALE_DB_PATH=data/whale_tracker.db

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# "json" for machine-readable structured logs, "console" for human-readable.
LOG_FORMAT=json
# Optional: also write structured logs to this file (leave empty to disable).
LOG_FILE=

# --- HTTP client behaviour -------------------------------------------------
# Requests per second, per provider. Free Helius/Birdeye tiers are strict.
HELIUS_RATE_LIMIT_RPS=8
BIRDEYE_RATE_LIMIT_RPS=1
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
# Cache GET responses in SQLite for this many seconds (0 disables the cache).
HTTP_CACHE_TTL_SECONDS=86400

# --- Ingestion limits (guardrails against runaway API spend) ---------------
# Max parsed transactions to pull per token before stopping.
MAX_TXS_PER_TOKEN=5000
# Ignore trades smaller than this USD value (dust / wash noise).
MIN_TRADE_USD=10
